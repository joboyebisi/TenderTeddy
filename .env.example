# Development only. Never commit real credentials.
PORT=4202
WANDERWRAP_CANONICAL_URL=https://api.wanderwrap.co.uk
WANDERWRAP_AUTH_ISSUER=https://auth.wanderwrap.co.uk
WANDERWRAP_MCP_TOKEN=replace-with-local-development-token
# Next.js web backend-for-frontend target. Keep provider credentials in the core,
# never in NEXT_PUBLIC_* variables or browser bundles.
WANDERWRAP_CORE_API_URL=http://127.0.0.1:4202
NEXT_PUBLIC_WANDERWRAP_URL=http://127.0.0.1:3000
# Alexa+ launch configuration (issued during Amazon developer onboarding)
ALEXA_ADDON_ID=
ALEXA_OAUTH_CLIENT_ID=
ALEXA_OAUTH_REDIRECT_URI=
# Facebook/X login is not required.
WANDERWRAP_LOGIN_PROVIDER=login-with-amazon
# Bedrock uses the Lambda IAM role in production; do not store a long-lived key here.
BEDROCK_ENABLED=false
BEDROCK_REGION=eu-west-2
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
# Optional local-only short-term bearer token (expires within 12 hours):
AWS_BEARER_TOKEN_BEDROCK=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=
AMAZON_PARTNER_TAG_GB=
AMAZON_PARTNER_TAG_US=
AMAZON_PARTNER_TAG_CA=
# Optional self-hosted/open-weight Big Five inference service. Keep disabled until
# its model card, weights, checksum, dataset rights and launch-market validation pass review.
PERSONALITY_MODEL_ENABLED=false
PERSONALITY_MODEL_ID=vladinc/bigfive-regression-model
PERSONALITY_MODEL_URL=http://127.0.0.1:8090/predict
PERSONALITY_MODEL_SHA256=

# Optional self-hosted XLM-R gift-preference extraction service. This proposes
# confirmation candidates only; it never ranks gifts or bypasses consent.
GIFT_PREFERENCE_MODEL_ENABLED=false
GIFT_PREFERENCE_MODEL_ID=wanderwrap/xlmr-gift-preference-v1
GIFT_PREFERENCE_MODEL_REVISION=
GIFT_PREFERENCE_MODEL_URL=http://127.0.0.1:8091/v1/extract
GIFT_PREFERENCE_MODEL_SHA256=
GIFT_PREFERENCE_MODEL_TIMEOUT_MS=5000
# off | shadow | canary | active
GIFT_PREFERENCE_MODEL_ROLLOUT_MODE=off
GIFT_PREFERENCE_MODEL_CANARY_PERCENT=0

# Provider selection. Values must name code-reviewed adapters registered at boot;
# configuration never dynamically imports arbitrary code or contains credentials.
PROVIDER_RECOMMENDATION_ID=wanderwrap-deterministic-ranker
PROVIDER_PREFERENCE_ID=
PROVIDER_CATALOGUE_ID=amazon-creators-request
PROVIDER_CATALOGUE_ENRICHMENT_ID=open-library-books
PROVIDER_EXPLANATION_ID=amazon-nova-explainer
PROVIDER_FULFILLMENT_ID=wanderwrap-routing-policy
PROVIDER_PAYMENT_ID=paypal-orders-v2-payload
PROVIDER_GIFT_ID=wanderwrap-gift-core

# Channel adapters are disabled until their app review, signing and account-link
# configuration is complete. Store real secrets in a secret manager.
TELEGRAM_CHANNEL_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
X_CHANNEL_ENABLED=false
X_WEBHOOK_SECRET=
FACEBOOK_CHANNEL_ENABLED=false
FACEBOOK_APP_SECRET=
