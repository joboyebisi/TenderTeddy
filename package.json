{
  "name": "wanderwrap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "node server.mjs",
    "demo": "node server.mjs",
    "test:e2e": "node --test test/e2e-http.test.mjs",
    "web:dev": "npm run dev --workspace @wanderwrap/web",
    "web:build": "npm run build --workspace @wanderwrap/web",
    "build:alexa": "vite build",
    "test": "node --test",
    "check": "npm run build:alexa && npm run web:build && node --check src/aws-handler.mjs && node --test"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1155.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.927.0",
    "@aws-sdk/client-dynamodb": "^3.927.0",
    "@aws-sdk/lib-dynamodb": "^3.927.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
